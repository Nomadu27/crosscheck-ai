# crosscheck-ai environment variables
# Copy to .env and fill in your values

# ── Required ─────────────────────────────────────────────
CROSSCHECK_API_KEY=sk-or-...
# or: OPENROUTER_API_KEY=sk-or-...

# ── InsAIts Monitoring (pip install crosscheck-ai[monitor]) ──
CROSSCHECK_MONITOR=false
INSAITS_API_KEY=
CROSSCHECK_MONITOR_ANCHOR=

# ── Session Defaults ─────────────────────────────────────
CROSSCHECK_MODE=balanced          # fast | balanced | quality
CROSSCHECK_REVIEW_TYPE=code       # code | plan | text | appstore
CROSSCHECK_MAX_ROUNDS=5
CROSSCHECK_OUTPUT=terminal        # terminal | json | markdown
CROSSCHECK_OBSERVER_PLAN=

# ── PR Bot (pip install crosscheck-ai[webhook]) ─────────
GITHUB_TOKEN=
GITLAB_TOKEN=
GITHUB_WEBHOOK_SECRET=
